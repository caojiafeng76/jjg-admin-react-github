{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/muse-spark-1.2-contributor",
  "plugin": ["./.opencode/ponytail/.opencode/plugins/ponytail.mjs"],
  "lsp": {
    "typescript": {
      "type": "npm",
      "package": "typescript-language-server",
      "command": [
        "typescript-language-server",
        "--stdio",
        "--tsserver-path",
        "C:/Users/Administrator/AppData/Roaming/npm/node_modules/typescript/lib/tsserver.js"
      ],
      "extensions": [
        ".ts",
        ".tsx",
        ".js",
        ".jsx",
        ".mjs",
        ".cjs",
        ".mts",
        ".cts"
      ]
    }
  },
  "mcp": {
    "supabase": {
      "type": "local",
      "command": [
        "powershell",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "$env:SUPABASE_ACCESS_TOKEN = [Environment]::GetEnvironmentVariable('SUPABASE_ACCESS_TOKEN', 'User'); npx -y @supabase/mcp-server-supabase --project-ref mlcptrkvkseyqxxlfcme",
      ],
      "enabled": true,
    },
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp@latest"],
      "enabled": true,
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
      "enabled": true,
    },
  },
}
