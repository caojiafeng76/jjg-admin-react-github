{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["./.opencode/ponytail/.opencode/plugins/ponytail.mjs"],
  "lsp": {
    "typescript": {
      "type": "npm",
      "package": "typescript-language-server",
      "command": [
        "typescript-language-server",
        "--stdio",
        "--tsserver-path",
        "C:/Users/Administrator/AppData/Roaming/npm/node_modules/typescript/lib/tsserver.js"
      ],
      "extensions": [
        ".ts",
        ".tsx",
        ".js",
        ".jsx",
        ".mjs",
        ".cjs",
        ".mts",
        ".cts"
      ]
    }
  },
  "mcp": {
    "spec-workflow": {
      "type": "local",
      "command": ["npx", "--no-install", "spec-workflow-mcp", "."],
      "enabled": true,
    },
    "sequential-thinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking",
      ],
      "enabled": true,
    },
    "supabase": {
      "type": "local",
      "command": [
        "powershell",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "$env:SUPABASE_ACCESS_TOKEN = [Environment]::GetEnvironmentVariable('SUPABASE_ACCESS_TOKEN', 'User'); npx -y @supabase/mcp-server-supabase --project-ref mlcptrkvkseyqxxlfcme",
      ],
      "enabled": true,
    },
    "serena": {
      "type": "local",
      "command": [
        "uvx",
        "-p",
        "3.13",
        "--from",
        "serena-agent",
        "serena",
        "start-mcp-server",
        "--project",
        ".",
        "--context=codex",
      ],
      "enabled": true,
    },
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp@latest"],
      "enabled": true,
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
      "enabled": true,
    },
  },
}
