{
  "name": "jjg-admin-react",
  "private": true,
  "version": "0.0.0",
  "packageManager": "bun@1.3.14",
  "type": "module",
  "scripts": {
    "postinstall": "bun scripts/fix-typescript6-alias.mjs",
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "check:bundle": "bun scripts/check-bundle-budget.mjs",
    "typecheck": "tsc -b",
    "test": "node --test scripts/supabase-pooler.test.mjs scripts/db-sql-guard.test.mjs aliyun-fc/supabase-proxy/server.test.js && vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "preview": "vite preview",
    "fc:package:syney-store-report": "bun scripts/package-syney-store-report-fc.mjs",
    "fc:package:supabase-proxy": "bun scripts/package-supabase-proxy-fc.mjs",
    "ai:doctor": "bun scripts/ai-doctor.mjs",
    "graphify:build": "graphify build .",
    "graphify:update": "graphify auto-update .",
    "db:doctor": "bun scripts/supabase-db-doctor.mjs",
    "db:push": "bun scripts/supabase-db-push.mjs",
    "db:push:api": "bun scripts/supabase-db-push-api.mjs",
    "db:push:dry-run": "bun scripts/supabase-db-push.mjs --dry-run",
    "db:query": "bun scripts/supabase-db-query.mjs",
    "db:types": "supabase gen types --lang typescript --linked --schema public > src/services/database.types.ts"
  },
  "dependencies": {
    "@ant-design/cssinjs": "^2.1.2",
    "@ant-design/icons": "^6.3.4",
    "@heroicons/react": "2.2.0",
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/react-query": "^5.104.2",
    "antd": "6.5.3",
    "dayjs": "^1.11.23",
    "immer": "^11.1.21",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "jszip": "^3.10.2",
    "pinyin-pro": "^3.29.5",
    "qr-scanner": "^1.4.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-qr-code": "2.2.0",
    "react-router-dom": "^7.18.4",
    "xlsx-js-style": "^1.2.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@ant-design/cli": "^6.5.3",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.104.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@typescript/old": "npm:typescript@6.0.3",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.30",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.120.0",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-mkcert": "^2.1.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@typescript/old": "npm:typescript@6.0.3",
    "dompurify": "3.4.12"
  }
}
